
# Local Postgres (provisioned in this dev container)
DATABASE_URL="postgresql://user:password@localhost:5432/ecomhunter_dev?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (leave blank to disable Google sign-in in the UI)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI providers — the app runs in demo mode with mocked AI output until at
# least one of these is set. Switchable per-org in Settings > AI Provider.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Redis (caching + BullMQ job queue). Leave blank to run jobs in-process
# without a queue (fine for demo mode).
REDIS_URL=""

# Field-level encryption for stored OAuth tokens / integration credentials
INTEGRATION_ENCRYPTION_KEY="generate-a-32-byte-random-key"

# Shopify Partner app (Admin API OAuth)
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL=""
SHOPIFY_SCOPES="read_products,write_products,read_orders,write_orders,read_content,write_content,read_discounts,write_discounts"

# Tiendanube / Nuvemshop app
TIENDANUBE_CLIENT_ID=""
TIENDANUBE_CLIENT_SECRET=""

# Observability
SENTRY_DSN=""

# Demo mode: when true, adapters that lack real credentials return clearly
# labeled synthetic data instead of failing.
DEMO_MODE="true"
